# Auth0 — domain and Client ID of the Auth0 Application (type: Single Page Application).
# Leave blank and the login page shows a "not configured" message instead of a broken
# login button.
NUXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NUXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-client-id

# Skip Auth0 login under `npm run dev` only — must be exactly "true". Has no effect on
# `npm run build`/`npm run preview` (see middleware/auth.global.ts).
NUXT_PUBLIC_SKIP_AUTH_LOCAL=true
